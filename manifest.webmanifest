{
  "name": "Habits",
  "short_name": "Habits",
  "description": "A private habit tracker that lives entirely on your phone.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f5f5f8",
